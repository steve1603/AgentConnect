# AI Roundtable configuration
#
# Copy this file to `.env` and fill in your API keys.
# Do NOT wrap values in quotes unless the value itself contains them.
# This file must never be committed with real keys in it.

# ---------------------------------------------------------------------------
# API keys (server-side only - never sent to the browser)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.6
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.7-flash

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/roundtable.db
LOG_LEVEL=info
OPEN_BROWSER=true

# ---------------------------------------------------------------------------
# Orchestration limits
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=120
PROVIDER_RETRIES=2
MAX_PROMPT_CHARS=30000
MAX_OUTPUT_TOKENS=16000
HISTORY_MESSAGE_LIMIT=24
HISTORY_CHAR_LIMIT=60000
DEFAULT_CHAIR=openai
